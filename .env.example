# Database
DATABASE_URL=postgresql+asyncpg://munch_user:munch_password@localhost:5432/munch_db
DATABASE_URL_SYNC=postgresql://munch_user:munch_password@localhost:5432/munch_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# University Domain
ALLOWED_EMAIL_DOMAIN=university.edu

# Redis (for real-time pub/sub)
REDIS_URL=redis://localhost:6379

# App
APP_NAME=Munch
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# AI / Recommendations
MIN_ORDERS_FOR_RECOMMENDATION=3
RECOMMENDATION_CACHE_TTL=300
